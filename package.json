{
  "name": "sflight-cap",
  "version": "1.0.0",
  "description": "Application SAP CAP de gestion des voyages SFLIGHT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "pretest": "npm run db:deploy",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand test/integration",
    "pretest:coverage": "npm run db:deploy",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "npm run lint:cds && npm run lint:js",
    "lint:cds": "cds compile '*' --to csn --dest gen/validation",
    "lint:js": "eslint server.js srv test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:deploy": "cds deploy --to sqlite:db.sqlite",
    "build": "cds build --production",
    "validate": "npm run format:check && npm run lint && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^2",
    "@cap-js/cds-test": "^1.0",
    "@sap/cds-dk": "^9",
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "eslint": "^10",
    "globals": "^16",
    "husky": "^9",
    "jest": "^29",
    "prettier": "^3"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/gen/"
    ],
    "collectCoverageFrom": [
      "srv/**/*.js",
      "server.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 45,
        "branches": 25,
        "functions": 50,
        "lines": 45
      }
    }
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "mocked"
      }
    },
    "[production]": {
      "requires": {
        "db": "hana",
        "auth": "xsuaa"
      }
    }
  }
}
